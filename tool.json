{
  "tool": {
    "id": "hve-no-ecg",
    "title": "Critérios de voltagem para HVE no ECG",
    "short": "Registra critérios eletrocardiográficos; não confirma nem exclui HVE",
    "desc": "Calcula os critérios de voltagem e produto da edição documentada a partir de um ECG calibrado. A ausência de critérios não exclui hipertrofia ventricular esquerda.",
    "lead": "Calcula os critérios de voltagem e produto da edição documentada a partir de um ECG calibrado. A ausência de critérios não exclui hipertrofia ventricular esquerda.",
    "kind": "Escore",
